#!/bin/sh

# Cudy LT300 v3 / MT7628 workaround:
# Keep 802.11n enabled but restrict AP transmissions to one spatial stream.
# Optional A/B-test workaround. It was part of the first router's tested profile,
# but its necessity with the patched driver has not been established. The second
# LT300 v3 ran without it after a short test; do not enable it by default.

IFACE="phy0-ap0"
TAG="wifi-mcs-limit"

apply_limit() {
	count=0
	while [ "$count" -lt 30 ]; do
		status="$(ubus call "hostapd.$IFACE" get_status 2>/dev/null | jsonfilter -e '@.status' 2>/dev/null || true)"
		if [ "$status" = 'ENABLED' ] && iw dev "$IFACE" set bitrates ht-mcs-2.4 0 1 2 3 4 5 6 7; then
			logger -t "$TAG" "Applied HT MCS0-7 TX mask to $IFACE"
			exit 0
		fi
		count=$((count + 1))
		sleep 1
	done

	logger -t "$TAG" "Failed to apply HT MCS0-7 TX mask after AP became ready on $IFACE"
	exit 1
}

apply_limit
